<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Performance Recorder profile for QuickPane's own trace events (PerfTrace.cs).
  It records QuickPane's events together with CPU samples, context switches, and window
  messages, so a stall shows which thread waited on which. See "Recording a performance trace"
  in docs/DEVELOPMENT.md.

  The provider is named by GUID because WPR accepts a GUID or a registered name, and an
  EventSource is not registered. The GUID is derived from the name "QuickPane", and
  PerfTraceTests.ProviderGuid_MatchesTheRecordingProfile fails if the two drift apart.
-->
<WindowsPerformanceRecorder Version="1.0" Author="QuickPane" Comments="QuickPane stall trace">
  <Profiles>
    <SystemCollector Id="SystemCollector_QuickPane" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </SystemCollector>

    <EventCollector Id="EventCollector_QuickPane" Name="QuickPane Event Collector">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </EventCollector>

    <SystemProvider Id="SystemProvider_QuickPane">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>

    <EventProvider Id="EventProvider_QuickPane" Name="c52f37e7-4bdd-5f3c-332f-56c59bf9dc07" Level="5" />
    <EventProvider Id="EventProvider_Win32k" Name="Microsoft-Windows-Win32k" NonPagedMemory="true" Level="4" />

    <Profile Id="QuickPane.Verbose.File" Name="QuickPane" Description="QuickPane events with CPU, waits, and window messages" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_QuickPane">
          <SystemProviderId Value="SystemProvider_QuickPane" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_QuickPane">
          <EventProviders>
            <EventProviderId Value="EventProvider_QuickPane" />
            <EventProviderId Value="EventProvider_Win32k" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
