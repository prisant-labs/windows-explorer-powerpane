<Window x:Class="PowerPane.UI.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to PowerPane"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height" Width="320" Topmost="True"
        ResizeMode="NoResize" UseLayoutRounding="True">
    <Border x:Name="Shell" CornerRadius="8" BorderThickness="1" Padding="14">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Add to PowerPane" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="PathText" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap" MaxHeight="48"
                       TextTrimming="CharacterEllipsis" Opacity="0.7" />

            <TextBlock x:Name="GroupLabel" Text="Group" FontSize="11" Opacity="0.7" Margin="0,0,0,2" />
            <ListBox x:Name="GroupList" MaxHeight="130" Background="Transparent" BorderThickness="1"
                     SelectionChanged="OnGroupChanged" />
            <TextBox x:Name="NewGroupBox" Margin="0,6,0,0" Visibility="Collapsed" Text="" />

            <TextBlock x:Name="TabLabel" Text="Tab" FontSize="11" Opacity="0.7" Margin="0,10,0,2" />
            <ListBox x:Name="TabList" MaxHeight="110" Background="Transparent" BorderThickness="1"
                     SelectionChanged="OnTabChanged" />
            <TextBox x:Name="NewTabBox" Margin="0,6,0,0" Visibility="Collapsed" Text="" />

            <TextBlock x:Name="HintText" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Width="74" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkBtn" Content="Add" Width="74" Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
